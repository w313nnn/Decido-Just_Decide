rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/decisions/{decisionId} {
      function ownsHistory() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      allow read, delete: if ownsHistory();
      allow create, update: if ownsHistory()
        && request.resource.data.userId == userId
        && request.resource.data.id == decisionId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'foodItemId', 'foodItemName', 'price', 'decidedAt', 'emoji', 'category', 'locationName', 'reason', 'campusId'])
        && request.resource.data.foodItemId is string
        && request.resource.data.foodItemName is string
        && request.resource.data.decidedAt is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
    }
  }
}
